# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=nexus_user
DB_PASSWORD=nexus_pass
DB_NAME=nexus
DB_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# NATS
NATS_URL=nats://localhost:4222

# gRPC Server
GRPC_PORT=9090
GRPC_ENABLE_REFLECTION=true

# HTTP Gateway (optional, for REST endpoints)
HTTP_PORT=8080

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Environment
ENVIRONMENT=development